# Copie para .env e preencha. Valores em Supabase Dashboard > Project Settings > API.
PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="<chave publishable/anon>"

# Chave pública VAPID usada pelo navegador para assinar o push (a mesma de VAPID_PUBLIC_KEY da Edge Function).
VITE_VAPID_PUBLIC_KEY="<chave pública VAPID>"

# Só para os testes E2E (npm run test:e2e). Nunca use no app nem commite os valores.
OSIRIS_E2E_PASSWORD="<senha das contas comprador-e2e e vendedor-e2e>"
# Usada apenas pelo teardown dos testes para apagar os registros [E2E] criados.
SUPABASE_SERVICE_ROLE_KEY="<secret key do projeto>"
